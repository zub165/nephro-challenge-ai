# Copy to /var/www/nephro-challenge-ai/backend/.env on GoDaddy VPS
#   cp .env.godaddy.example .env && nano .env
# .env is gitignored: only this .env.example with placeholders is committed.
# Never commit a real credential value.

SECRET_KEY=change-me-generate-with-python-secrets
DEBUG=False

DB_NAME=nephro_challenge
DB_USER=nephro_app
DB_PASSWORD=CHANGE_STRONG_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5434

# Live API host. There is no DNS record for api.nephrochallenge.ai.
ALLOWED_HOSTS=nephro-api.schedulemygroup.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://zub165.github.io,https://schedulemygroup.com,https://www.schedulemygroup.com
CSRF_TRUSTED_ORIGINS=https://nephro-api.schedulemygroup.com,https://zub165.github.io

# Optional: internal Gunicorn port (must match nginx upstream; avoid 8000, 8004, 8011, 8012)
GUNICORN_PORT=8007

AI_PROVIDER=auto
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=llama3
LLAMA_API_KEY=ollama

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Admin account (read by `manage.py seed_data`; required only when creating the admin).
# Leave these unset to skip seed_data: install.sh and deploy.sh then skip it.
ADMIN_USERNAME=change-me-admin-username
ADMIN_EMAIL=change-me-admin-email
ADMIN_PASSWORD=change-me-strong-password

# Social auth (Google / Apple OAuth). Each key must be on its own line:
# a literal "\n" between them makes systemd drop the whole assignment.
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
APPLE_CLIENT_ID=ai.nephrochallenge.app
