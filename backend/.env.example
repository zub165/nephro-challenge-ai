# .env is gitignored; ONLY this .env.example with placeholders is committed.
# Every SECRET_KEY / DB_* / ADMIN_PASSWORD / *_API_KEY value below is a placeholder
# — never commit a real credential.

# --- Required (no defaults; startup fails if unset) ---
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-50
DB_NAME=nephro_challenge
DB_USER=change-me-db-user
DB_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=5432

DEBUG=True

# --- AI: GoDaddy VPS LLaMA (Ollama) — recommended ---
AI_PROVIDER=auto
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=qwen2.5:0.5b-instruct
LLAMA_API_KEY=ollama
# Cap Ollama context so the 3.8 GB VPS stays in RAM. (1.5b/3b models OOM-kill workers here.)
LLM_NUM_CTX=4096

# --- AI: OpenAI fallback (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://zub165.github.io,https://nephrochallenge.ai
ALLOWED_HOSTS=localhost,127.0.0.1,api.nephrochallenge.ai

# --- Admin account (read by `manage.py seed_data`; required only when creating the admin) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nephrochallenge.com
ADMIN_PASSWORD=change-me

# --- Smoke-test script credentials (optional; `scripts/test_endpoints.py`) ---
# SCRIPT_TEST_EMAIL=change-me
# SCRIPT_TEST_PASSWORD=change-me
# SMOKE_REPORT_PATH=/absolute/path/to/docs/FRONTEND_API.md

# --- Social auth (Google / Apple OAuth) ---
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=ai.nephrochallenge.app
