SECRET_KEY=your-secret-key-here
DEBUG=True
DB_NAME=nephro_challenge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- AI: GoDaddy VPS LLaMA (Ollama) — recommended ---
AI_PROVIDER=auto
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=qwen2.5:0.5b-instruct
LLAMA_API_KEY=ollama
# Cap Ollama context so the 3.8 GB VPS stays in RAM. (1.5b/3b models OOM-kill workers here.)
LLM_NUM_CTX=4096

# --- AI: OpenAI fallback (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://zub165.github.io,https://nephrochallenge.ai
ALLOWED_HOSTS=localhost,127.0.0.1,api.nephrochallenge.ai

# --- Admin account (read by `manage.py seed_data`) ---
# .env is gitignored; ONLY .env.example with placeholders is committed.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nephrochallenge.com
ADMIN_PASSWORD=change-me

# --- Social auth (Google / Apple OAuth) ---
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=ai.nephrochallenge.app
