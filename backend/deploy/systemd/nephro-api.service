[Unit]
Description=Nephro Challenge AI Django API (Gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/nephro-challenge-ai/backend
EnvironmentFile=/var/www/nephro-challenge-ai/backend/.env
ExecStart=/var/www/nephro-challenge-ai/backend/venv/bin/gunicorn \
    nephro_challenge.wsgi:application \
    -c /var/www/nephro-challenge-ai/backend/deploy/gunicorn/gunicorn.conf.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
